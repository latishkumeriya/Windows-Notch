<Window x:Class="NotchWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:NotchWin.Services"
        Title="NotchWin" Width="180" Height="44"
        WindowStyle="None" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource TextBrush}" FontSize="12"
        UseLayoutRounding="True">

    <!-- Keeps a DWM frame (needed for the acrylic backdrop, rounded corners and shadow) with no visible title bar. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- Dark-theme defaults; ThemeService replaces these to follow the Windows theme and accent colour. -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#99202020"/>
        <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#FF2C2C2C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#C5FFFFFF"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#87FFFFFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="CardPressedBrush" Color="#08FFFFFF"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#8BFFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF60CDFF"/>
        <SolidColorBrush x:Key="OnAccentBrush" Color="#FF000000"/>
        <LinearGradientBrush x:Key="SheenBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#14FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.6"/>
        </LinearGradientBrush>
        <svc:BoolToVisibilityConverter x:Key="BoolVis"/>
        <svc:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentRoundButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="{DynamicResource AccentBrush}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="9,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="Tabs"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="9,4,9,6">
                            <Grid>
                                <ContentPresenter x:Name="Content" VerticalAlignment="Center" Opacity="0.75"/>
                                <Border x:Name="Indicator" Height="3" Width="16" CornerRadius="1.5" VerticalAlignment="Bottom"
                                        Margin="0,0,0,-6" Background="{DynamicResource AccentBrush}" Visibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter TargetName="Content" Property="Opacity" Value="1"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrackEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="14" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SeekSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" Opacity="0.45" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{DynamicResource SurfaceSolidBrush}" Stroke="{DynamicResource StrokeBrush}"/>
                                                    <Ellipse Margin="3" Fill="{DynamicResource AccentBrush}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="34,6,10,6">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Focus" Height="2" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="0,0,5,5"
                                    Background="{DynamicResource AccentBrush}" Visibility="Hidden"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Island" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True"
            MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
            MouseLeftButtonUp="Island_MouseLeftButtonUp">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="StartupItem" Header="Start with Windows" IsCheckable="True" Click="Startup_Click"/>
                <MenuItem x:Name="PauseItem" Header="Pause clipboard history" IsCheckable="True" Click="Pause_Click"/>
                <MenuItem Header="Open screenshots folder" Click="OpenFolder_Click"/>
                <Separator/>
                <MenuItem Header="Exit NotchWin" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Border Background="{DynamicResource SheenBrush}" IsHitTestVisible="False"/>
            <!-- ===== Compact (collapsed) states ===== -->
            <!-- Top margin = strip pushed above the screen edge so the top rounded corners are hidden. -->
            <Grid x:Name="Compact" Height="34" VerticalAlignment="Top" Margin="12,10,12,0">
                <Grid x:Name="CompactMedia" Visibility="Collapsed">
                    <Border Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left" Background="{DynamicResource CardBrush}">
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Media.Art}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="16">
                        <Rectangle x:Name="Bar0" Width="3" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Media.Accent}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar1" Width="3" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Media.Accent}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar2" Width="3" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Media.Accent}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Bar3" Width="3" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Media.Accent}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </Grid>

                <Grid x:Name="CompactToast" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastGlyph" FontFamily="{StaticResource Icons}" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="ToastImageHost" CornerRadius="5" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="ToastImage" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ToastText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>

            <!-- ===== Expanded ===== -->
            <!-- Fixed size so the content is revealed, not reflowed, while the window grows. -->
            <Grid x:Name="Expanded" Width="500" Height="176" Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="Clock" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleBrush}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabMedia" Style="{StaticResource Tab}" IsChecked="True" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Media"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabClip" Style="{StaticResource Tab}" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE77F;" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Clipboard"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabShots" Style="{StaticResource Tab}" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE722;" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Screenshots"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>

                <!-- Media -->
                <Grid x:Name="MediaPanel" Grid.Row="1">
                    <Grid Visibility="{Binding Media.HasSession, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="96" Height="96" CornerRadius="8" Background="{DynamicResource CardBrush}" VerticalAlignment="Top">
                            <Grid>
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="28"
                                           Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Media.Art}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Media.Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Media.Artist}" Foreground="{DynamicResource SubtleBrush}" FontSize="12"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            <Button Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Click="Source_Click" ToolTip="Switch media source">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding Media.Accent}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Media.Source}" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Slider x:Name="Seek" Style="{StaticResource SeekSlider}" Margin="0,6,0,0"
                                    Minimum="0" Maximum="{Binding Media.Duration}"
                                    Value="{Binding Media.Position, Mode=TwoWay}"
                                    PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up"/>
                            <DockPanel Margin="0,0,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Media.DurationText}" Foreground="{DynamicResource SubtleBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding Media.PositionText}" Foreground="{DynamicResource SubtleBrush}" FontSize="11"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-2,0,0">
                                <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="14" Width="34" Height="34" Click="Prev_Click"/>
                                <Button Style="{StaticResource AccentRoundButton}" Content="{Binding Media.PlayGlyph}" FontSize="15"
                                        Width="38" Height="38" Margin="8,0" Click="PlayPause_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="14" Width="34" Height="34" Click="Next_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Media.HasSession, Converter={StaticResource InvBoolVis}}">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="24" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SubtleBrush}"/>
                        <TextBlock Text="Nothing playing" Margin="0,10,0,0" Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Clipboard -->
                <Grid x:Name="ClipPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                                Click="ClearClips_Click" ToolTip="Clear everything except pinned">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE894;" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Clear"/>
                            </StackPanel>
                        </Button>
                        <Grid>
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE721;" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource SubtleBrush}" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Search clipboard  (Ctrl+Alt+V)" Margin="35,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource FaintBrush}" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl x:Name="ClipList" ItemsSource="{Binding Clips.View}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:ClipItem}">
                                    <Border x:Name="Row" Background="{DynamicResource CardBrush}" CornerRadius="5" Padding="8,1,2,1"
                                            Margin="0,0,0,5" Cursor="Hand" MouseLeftButtonUp="ClipItem_Click"
                                            ToolTip="Click to paste • Shift+Click to copy only">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontFamily="{StaticResource Icons}" Text="{Binding Glyph}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SubtleBrush}"
                                                       Visibility="{Binding IsImage, Converter={StaticResource InvBoolVis}}"/>
                                            <Border Width="30" Height="20" CornerRadius="4" HorizontalAlignment="Left"
                                                    Visibility="{Binding IsImage, Converter={StaticResource BoolVis}}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Preview}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" VerticalAlignment="Center" Margin="10,0,4,0"
                                                       Foreground="{DynamicResource FaintBrush}" FontSize="11"/>
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE8A7;" FontSize="12"
                                                    ToolTip="Open link" Click="OpenLink_Click"
                                                    Visibility="{Binding IsLink, Converter={StaticResource BoolVis}}"/>
                                            <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="{Binding PinGlyph}" FontSize="12"
                                                    ToolTip="Pin" Click="Pin_Click"/>
                                            <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                                                    ToolTip="Remove" Click="DeleteClip_Click"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Text="Copy something and it will show up here" Foreground="{DynamicResource SubtleBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasItems, ElementName=ClipList, Converter={StaticResource InvBoolVis}}"/>
                </Grid>

                <!-- Screenshots -->
                <Grid x:Name="ShotsPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource PillButton}" Click="Region_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7A8;" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Region"/>
                                <TextBlock Text="  Ctrl+Alt+S" Foreground="{DynamicResource FaintBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Click="FullScreen_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE740;" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Full screen"/>
                                <TextBlock Text="  Ctrl+Alt+F" Foreground="{DynamicResource FaintBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Click="OpenFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE838;" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Folder"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="ShotScroller_PreviewMouseWheel">
                        <ItemsControl x:Name="ShotList" ItemsSource="{Binding Shots.Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:ShotItem}">
                                    <Grid x:Name="Tile" Width="136" Height="86" Margin="0,0,8,0" Cursor="Hand" Background="Transparent"
                                          ToolTip="Click to open • Drag into any app"
                                          PreviewMouseLeftButtonDown="Shot_PreviewDown" MouseMove="Shot_MouseMove"
                                          MouseLeftButtonUp="Shot_Click">
                                        <Border CornerRadius="8" Background="{DynamicResource CardBrush}">
                                            <Border CornerRadius="8">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Border>
                                        <Border x:Name="Actions" CornerRadius="16" Background="#D9000000" Padding="2"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Opacity="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy" Click="CopyShot_Click"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit in Paint" Click="EditShot_Click"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete" Click="DeleteShot_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Text="No screenshots yet — press Ctrl+Alt+S" Foreground="{DynamicResource SubtleBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasItems, ElementName=ShotList, Converter={StaticResource InvBoolVis}}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
